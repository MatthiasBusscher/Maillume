# Infrastructure-only values used by Docker Compose. Do not pass this file to
# the Maillume application container.
# Name of the Docker network shared with the host's reverse proxy. Defaults to
# maillume-edge when unset.
MAILLUME_EDGE_NETWORK=maillume-edge

# Local/manual Compose default. Automated deployment overrides this with the
# immutable commit SHA produced by GitHub Actions.
MAILLUME_IMAGE=ghcr.io/matthiasbusscher/maillume:sha-<full-commit>
