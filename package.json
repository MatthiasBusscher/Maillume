{
  "name": "maillume",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:ocr && next dev",
    "build": "npm run prepare:ocr && next build",
    "start": "next start",
    "lint": "eslint .",
    "test:analysis": "tsc -p tsconfig.heuristics.json && node scripts/run-compiled-tests.mjs --suite=analysis",
    "test:compiled": "tsc -p tsconfig.heuristics.json && node scripts/run-compiled-tests.mjs --suite=all",
    "test:heuristics": "tsc -p tsconfig.heuristics.json && node .analysis-tests/src/lib/analysis/heuristic-analysis.test.js",
    "test:security": "tsc -p tsconfig.heuristics.json && node scripts/run-compiled-tests.mjs --suite=security && node --test tests/content/*.test.mjs",
    "test:deployment": "node --test tests/deployment/*.test.mjs",
    "test:integrations": "npm run check:contracts && node integrations/browser-extension/extension.test.cjs && node tests/integrations/openapi-contract.cjs",
    "test:extension": "node tests/integrations/browser-extension.smoke.cjs",
    "test:smoke": "playwright test",
    "test:smoke:ui": "playwright test --ui",
    "package:extension": "./scripts/package-browser-extension.sh",
    "package:integrations": "./scripts/package-integrations.sh",
    "generate:contracts": "node scripts/generate-contract-artifacts.mjs",
    "check:contracts": "node scripts/check-contract-artifacts.mjs --check",
    "eval:heuristic": "tsc -p tsconfig.heuristics.json && node scripts/evaluate-heuristic.mjs",
    "bench:heuristic": "tsc -p tsconfig.heuristics.json && node scripts/benchmark-heuristic.mjs",
    "report:feedback": "tsc -p tsconfig.heuristics.json && node scripts/report-feedback.mjs",
    "generate:integration-icons": "node scripts/generate-integration-icons.mjs",
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "jsqr": "1.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "tldts": "^7.4.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/nld": "1.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.0"
  }
}
